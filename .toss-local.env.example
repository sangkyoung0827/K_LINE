# Copy this file to .toss-local.env only on the registered MacBook.
# Keep the copied file private: it is ignored by Git.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Optional. Uses the first eligible brokerage account when omitted.
TOSSINVEST_ACCOUNT_SEQ=

# The production K_LINE origin is allowed by default. Use this only for local testing.
# KLINE_ALLOWED_ORIGINS=https://kline-nine-wheat.vercel.app,http://localhost:3000
