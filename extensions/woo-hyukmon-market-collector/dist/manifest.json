{
  "manifest_version": 3,
  "name": "WooHyukmon Market Collector",
  "version": "1.0.0",
  "description": "사용자가 연 공개 쇼핑 페이지에서 전통주 시장 데이터를 수집해 WooHyukmon Staging으로 전송합니다.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://search.shopping.naver.com/*",
    "https://gift.kakao.com/*",
    "https://kline-nine-wheat.vercel.app/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "WooHyukmon Market Collector" },
  "content_scripts": [
    {
      "matches": ["https://search.shopping.naver.com/*", "https://gift.kakao.com/*"],
      "js": ["platform-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://kline-nine-wheat.vercel.app/*", "http://localhost/*"],
      "js": ["webapp-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["https://kline-nine-wheat.vercel.app/*", "http://localhost/*"]
  }
}
